#!/bin/bash
# Skript zur Ausfuehrung von GHDL im GitHub Codespace. Installiere Skript im GitHub Codespace:
# code --install-extension rjyoung.vscode-modern-vhdl-support ; mkdir -p ~/.local/bin && curl -fsSL https://raw.githubusercontent.com/HSDDigitalLabor/problems_hdl/refs/heads/diginfo2026/sim -o ~/.local/bin/simulation && chmod +x ~/.local/bin/simulation
# Aufruf im Aufgabenordner mit CS50-Slug: simulation <org>/<repo>/<branch>/<aufgabe>
# Oder lokal: simulation [--local] <aufgabe> [--local]

set -eo pipefail

# Farbig formatierte Ausgaben nur wenn die Ausgabe ein Terminal ist
if [ -t 1 ]; then
  RED=$'\e[31m'; GRN=$'\e[32m'; YEL=$'\e[33m'; BLU=$'\e[1;34m'; CYN=$'\e[36m'; RST=$'\e[0m'
else
  RED=""; GRN=""; YEL=""; BLU=""; CYN=""; RST=""
fi
info() { echo "${BLU}>> $*${RST}"; }
err()  { echo "${RED}FEHLER: $*${RST}"; }

# Parameter parsen (--local Flag herausfiltern)
LOCAL_MODE=false
ARGS=()

for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    LOCAL_MODE=true
  else
    ARGS+=("$arg")
  fi
done

SLUG="${ARGS[0]}"

if [ -z "$SLUG" ]; then
  if [ "$LOCAL_MODE" = true ]; then
    echo "Aufruf: simulation --local <aufgabe>"
  else
    echo "Aufruf: simulation <org>/<repo>/<branch>/<aufgabe> [--local]"
  fi
  exit 1
fi

M=$(basename "$SLUG")

[ -f "$M.vhd" ] || { err "$M.vhd nicht gefunden. Bist du im Ordner '$M'?"; exit 1; }

# 1. GHDL-Installation als Prebuilt-Binary (gleiche Version wie im check50-Check), Ablage in ~/.local
GHDL_VERSION="6.0.0"
GHDL_DIR="$HOME/.local/ghdl"
GHDL="$GHDL_DIR/bin/ghdl"
if [ ! -x "$GHDL" ]; then
  info "Installiere GHDL $GHDL_VERSION (einmalig) ..."
  GTMP=$(mktemp -d)
  curl -fsSL "https://github.com/ghdl/ghdl/releases/download/v$GHDL_VERSION/ghdl-mcode-$GHDL_VERSION-ubuntu24.04-x86_64.tar.gz" \
    | tar -xz -C "$GTMP"
  # Verschachtelten Ordner erkennen (bin/ghdl suchen)
  FOUND=$(find "$GTMP" -path '*/bin/ghdl' | head -1)
  [ -n "$FOUND" ] || { err "GHDL-Archiv enthält kein bin/ghdl"; rm -rf "$GTMP"; exit 1; }
  rm -rf "$GHDL_DIR"
  mkdir -p "$(dirname "$GHDL_DIR")"
  mv "$(dirname "$(dirname "$FOUND")")" "$GHDL_DIR"
  rm -rf "$GTMP"
fi

# 2. Vaporview-Extension in VSCode installieren (optional falls nicht installiert, bricht nie ab)
if command -v code >/dev/null 2>&1; then
  if ! code --list-extensions 2>/dev/null | grep -qi '^lramseyer.vaporview$'; then
    info "Installiere VS Code Extension Vaporview (einmalig) ..."
    code --install-extension lramseyer.vaporview >/dev/null 2>&1 \
      && echo "${GRN}Vaporview installiert.${RST}" \
      || echo "${YEL}Vaporview konnte nicht installiert werden (optional).${RST}"
  fi
else
  echo "${YEL}'code' nicht gefunden - Vaporview bitte manuell installieren.${RST}"
fi

# 3. Testbench Downlaod via Git (shallow + sparse) in Temp-Ordner oder --local aus /checks
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

if [ "$LOCAL_MODE" = true ]; then
  info "Verwende lokale Testbench ..."
  TB="./checks/${M}_tb.vhd"
  [ -f "$TB" ] || { err "Lokale Testbench '$TB' nicht im aktuellen Verzeichnis gefunden."; exit 1; }
else
  ORG_REPO=$(echo "$SLUG" | cut -d/ -f1-2)
  BRANCH=$(echo "$SLUG" | cut -d/ -f3)
  PROBLEM=$(echo "$SLUG" | cut -d/ -f4-)

  info "Hole Testbench ..."
  export GIT_TERMINAL_PROMPT=0
  git clone -q --depth 1 --no-checkout --branch "$BRANCH" \
      "https://github.com/$ORG_REPO.git" "$TMP/repo" >/dev/null 2>&1 \
    || { err "Repository/Branch '$ORG_REPO@$BRANCH' konnte nicht geladen werden"; exit 1; }
  git -C "$TMP/repo" sparse-checkout set --no-cone "/$PROBLEM/checks/${M}_tb.vhd" >/dev/null 2>&1
  git -C "$TMP/repo" checkout -q >/dev/null 2>&1
  TB="$TMP/repo/$PROBLEM/checks/${M}_tb.vhd"
  [ -f "$TB" ] || { err "Testbench für '$M' nicht im Repository gefunden"; exit 1; }
fi

# 4. Analysieren
info "Kompiliere ..."
"$GHDL" analyze --workdir="$TMP" "$M.vhd" "$TB"

# 5. Simulieren: Pfade entfernen, dann formatieren
info "Simuliere ..."
rm -f "${M}_waveform.vcd"
OUT="$TMP/sim.out"
set +e
"$GHDL" elab-run --workdir="$TMP" "${M}_tb" --vcd="${M}_waveform.vcd" --stop-time=100us 2>&1 \
  | tee "$OUT" \
  | sed -E \
      -e 's#^.*_tb\.vhd:[0-9]+:[0-9]+:(@[^:]*):\(report note\): #[\1] #' \
      -e 's#[^ ]*_tb\.vhd:[0-9]+:[0-9]+:##' \
      -e "/\((assertion [a-z]+|error)\)/{s/.*/${RED}&${RST}/;b}" \
      -e "/warning\)/{s/.*/${YEL}&${RST}/;b}" \
      -e "s/^(\[@[^]]*\])/${CYN}\1${RST}/"
RC=${PIPESTATUS[0]}
set -e

# Fehlschlag erst am Ende bewerten
NERR=$(grep -ciE 'assertion (error|failure)' "$OUT" || true)

if [ "$RC" -ne 0 ] || [ "$NERR" -gt 0 ]; then
  echo "${RED}>> Simulation fehlgeschlagen ($NERR Assertion-Fehler, ghdl-Exit-Code $RC)${RST}"
  [ -f "${M}_waveform.vcd" ] && echo "${YEL}   Die Waveform ${M}_waveform.vcd zeigt den Verlauf zum Debuggen.${RST}"
  exit 1
fi

echo "${GRN}>> Fertig. Waveform-Datei ${M}_waveform.vcd kann mit Vaporview geöffnet werden.${RST}"